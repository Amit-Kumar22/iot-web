# ---------------------------------------------------------------- backend

# MongoDB connection string (on the VPS: the local mongod)
MONGODB_URI=mongodb://127.0.0.1:27017/iot-platform

# Secret used to sign login tokens. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Website + REST API + WebSocket port
PORT=5010
# MQTT broker port for devices (MQTT_ENABLED=false turns it off)
MQTT_PORT=1883
MQTT_ENABLED=true

# Accounts (by email) that can edit the mobile app's appliance list on the website
ADMIN_EMAILS=

# Website origins allowed to call the API from a browser (comma-separated), or *
CORS_ORIGIN=*

# Phone push notifications via the Expo Push Service (set false to turn off).
# EXPO_ACCESS_TOKEN is only needed if "enhanced push security" is on at expo.dev.
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=

# Sensor history and notifications are deleted after this many days
HISTORY_RETENTION_DAYS=30

# --------------------------------------------------------------- frontend

# Backend base URL the website calls. Leave empty when the website is served
# by the same backend (default). Set it when the website is hosted elsewhere.
# Read at build time: run `npm run build` again after changing it.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MQTT_PORT=1883
