    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.1",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
